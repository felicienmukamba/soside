# ---------- Base de données (Neon) ----------
# Chaîne de connexion « pooled » fournie par Neon (Dashboard > Connection details).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# ---------- Mode d'exécution ----------
# monolith : gateway + microservices dans un seul processus (Vercel). Vide : microservices séparés reliés par Redis (docker-compose).
GATEWAY_MODE=monolith
# true uniquement pour `npm run db:setup` (création / mise à jour du schéma). Toujours false sur Vercel.
DB_SYNCHRONIZE=false
STORE_SEED=false

# ---------- Sécurité ----------
# Secret de signature des jetons de connexion (64+ caractères aléatoires). Identique partout où l'API tourne.
JWT_SECRET=change-me
# Sites autorisés à appeler l'API depuis le navigateur (séparés par des virgules).
CORS_ORIGINS=https://soside.vercel.app,https://soside-store.vercel.app

# ---------- E-mails (codes de vérification) ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

# ---------- Boutique ----------
STORE_CURRENCY=USD
STORE_CITIES=Goma,Bukavu,Uvira
STORE_SHIPPING_FEE=5
STORE_FREE_SHIPPING_FROM=100

# ---------- IA (optionnel) ----------
GEMINI_API_KEY=

# ---------- Redis (mode microservices uniquement) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
